generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}
enum Role {
  USER
  ADMIN
}
enum Phase {
  LOBBY
  FOCUS
  BREAK
  ENDED
}
enum ConnectionState {
  CONNECTED
  DISCONNECTED
}
model User {
  id           String @id @default(cuid())
  username     String @unique
  passwordHash String
  nickname     String
  avatarId     String @default("lake")
  role         Role @default(USER)
  createdAt    DateTime @default(now())
  authSessions AuthSession[]
  ownedRooms   Room[]
  memberships  RoomMember[]
  receipts     CommandReceipt[]
  tasks        Task[]
  messages     ChatMessage[]
  presence     PresenceInterval[]
  records      StudyRecord[]
}
model AuthSession {
  id        String @id @default(cuid())
  tokenHash String @unique
  userId    String
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  @@index([userId])
}
model Room {
  id        String @id @default(cuid())
  code      String @unique
  name      String
  ownerId   String
  owner     User @relation(fields: [ownerId], references: [id])
  sessionId String @unique
  session   StudySession @relation(fields: [sessionId], references: [id])
  capacity  Int @default(8)
  revision  Int @default(1)
  createdAt DateTime @default(now())
  members   RoomMember[]
  messages  ChatMessage[]
}
model StudySession {
  id           String @id @default(cuid())
  phase        Phase @default(LOBBY)
  roundNo      Int @default(0)
  focusSeconds Int
  breakSeconds Int
  phaseStartAt DateTime?
  phaseEndAt   DateTime?
  startedAt    DateTime?
  endedAt      DateTime?
  endReason    String?
  feedbackVersion Int @default(1)
  createdAt    DateTime @default(now())
  room         Room?
  intervals    PhaseInterval[]
  presence     PresenceInterval[]
  tasks        Task[]
  messages     ChatMessage[]
  records      StudyRecord[]
}
model PhaseInterval {
  id        String @id @default(cuid())
  sessionId String
  session   StudySession @relation(fields: [sessionId], references: [id])
  roundNo   Int
  phase     Phase
  startAt   DateTime
  endAt     DateTime?
  @@unique([sessionId, roundNo, phase])
}
model PresenceInterval {
  id        String @id @default(cuid())
  sessionId String
  session   StudySession @relation(fields: [sessionId], references: [id])
  userId    String
  user      User @relation(fields: [userId], references: [id])
  startAt   DateTime
  endAt     DateTime?
  endReason String?
  @@index([sessionId, userId])
}
model Task {
  id          String @id @default(cuid())
  sessionId   String
  session     StudySession @relation(fields: [sessionId], references: [id])
  userId      String
  user        User @relation(fields: [userId], references: [id])
  title       String
  visibility  String @default("PRIVATE")
  firstCompletedRound Int?
  completed   Boolean @default(false)
  completedAt DateTime?
  version     Int @default(1)
  createdAt   DateTime @default(now())
  @@index([sessionId, userId])
}
model ChatMessage {
  id        String @id @default(cuid())
  roomId    String
  room      Room @relation(fields: [roomId], references: [id])
  sessionId String
  session   StudySession @relation(fields: [sessionId], references: [id])
  userId    String
  user      User @relation(fields: [userId], references: [id])
  content   String
  createdAt DateTime @default(now())
  requestId String
  @@unique([userId, requestId])
  @@index([sessionId, createdAt])
  @@index([userId, createdAt])
  @@index([createdAt])
}
model StudyRecord {
  id              String @id @default(cuid())
  sessionId       String
  session         StudySession @relation(fields: [sessionId], references: [id])
  userId          String
  user            User @relation(fields: [userId], references: [id])
  focusSeconds    Int
  roundsCompleted Int
  tasksDone       Int
  tasksTotal      Int
  studiedWith     Int
  @@unique([sessionId, userId])
  @@index([userId, id])
}
model RoomMember {
  id              String @id @default(cuid())
  roomId          String
  room            Room @relation(fields: [roomId], references: [id])
  userId          String
  user            User @relation(fields: [userId], references: [id])
  seatIndex       Int
  ready           Boolean @default(false)
  afk             Boolean @default(false)
  connectionState ConnectionState @default(DISCONNECTED)
  joinedAt        DateTime @default(now())
  leftAt          DateTime?
  lastSeenAt      DateTime @default(now())
  reconnectDeadlineAt DateTime?
  @@unique([roomId, userId])
  @@index([userId, leftAt])
  @@index([roomId, leftAt])
}
model CommandReceipt {
  id          String @id @default(cuid())
  userId      String
  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)
  requestId   String
  commandType String
  payloadHash String
  result      String
  roomId      String?
  createdAt   DateTime @default(now())
  @@unique([userId, requestId])
  @@index([createdAt])
}
