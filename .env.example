# Relative SQLite paths are resolved from prisma/. Keep this directory across updates.
# Production may use an absolute persistent path, e.g. file:D:/FocusSpaceData/focusspace.db
DATABASE_URL="file:./data/focusspace.db"
PORT=3001
HOST=127.0.0.1
# Set the exact browser origins (scheme + hostname + port), separated by commas.
APP_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3001,http://127.0.0.1:3001
# Use true only with HTTPS.
COOKIE_SECURE=false
SESSION_DAYS=7
DISCONNECT_GRACE_MS=60000
# Enables the existing 45/15 second preset and explicit npm run demo:init.
DEMO_MODE=false
